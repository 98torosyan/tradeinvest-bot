# Copy this file to .env for local testing (never commit the real .env).
# In production these are set as GitHub Actions repo secrets instead --
# see README.md "GitHub-ում տեղադրելը" section.

TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# Optional -- without it, macro (Fed rate / CPI) facts are simply
# left out of the plan instead of being invented. Free, instant
# signup: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional -- direct Instagram auto-posting (scripts/publish_to_instagram.py).
# Without these, everything still runs and is sent to Telegram; Instagram
# publish steps just no-op. See README.md "Instagram-ում ուղիղ auto-post".
IG_USER_ID=
IG_ACCESS_TOKEN=

# Optional -- automatic monthly refresh of IG_ACCESS_TOKEN
# (scripts/refresh_ig_token.py / .github/workflows/refresh-token.yml).
# Same Meta app used to create IG_ACCESS_TOKEN above.
FB_APP_ID=
FB_APP_SECRET=
# Optional -- lets the token refresh write the new IG_ACCESS_TOKEN
# straight into GitHub Actions secrets. Without it, the new token is
# sent to you on Telegram to paste in by hand.
GH_PAT=
