# Copy this file to .env for local testing (never commit the real .env).
# In production these are set as GitHub Actions repo secrets instead --
# see README.md "GitHub-ում տեղադրելը" section.
#
# EVERY variable below is optional -- nothing here is required just to
# make the pipeline run. For a fully-automatic Instagram-only bot (no
# Telegram at all), only fill in the IG_* + FB_* + GH_PAT block further
# down.

# Optional -- Telegram is a side-channel delivery only. Leave both blank
# to skip Telegram entirely; nothing else depends on it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional -- without it, macro (Fed rate / CPI) facts are simply
# left out of the plan instead of being invented. Free, instant
# signup: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Instagram auto-posting (the main channel) ---------------------------
# Required for auto-posting to Instagram (scripts/publish_to_instagram.py).
# Without these, the pipeline still runs but only produces the files (and
# sends to Telegram if that's configured); nothing gets posted anywhere.
# See README.md "Instagram-ում ուղիղ auto-post".
IG_USER_ID=
IG_ACCESS_TOKEN=

# Strongly recommended alongside IG_ACCESS_TOKEN, for a truly hands-off,
# zero-manual-steps setup -- automatic monthly refresh of IG_ACCESS_TOKEN
# (scripts/refresh_ig_token.py / .github/workflows/refresh-token.yml).
# Same Meta app used to create IG_ACCESS_TOKEN above.
FB_APP_ID=
FB_APP_SECRET=
# Recommended -- lets the token refresh write the new IG_ACCESS_TOKEN
# straight into GitHub Actions secrets, so nothing is ever posted or
# copied by hand. Without it, the new token lands in that run's GitHub
# Actions summary page (and on Telegram too, if configured) for you to
# paste in manually once every ~2 months.
GH_PAT=
